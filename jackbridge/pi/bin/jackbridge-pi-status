#!/usr/bin/env bash
# jackbridge-pi-status — read-only status of the JackBridge netadapter slave.
#
# Consumed by the Mac (`jackbridge-ctl pi-status` over ssh) and the pi LCD UI
# (modalapi/ethernet/manager.py), replacing `systemctl is-active` — its
# MAINPID does not track netadapter, which jack_load runs in-process.
#
# Output: key=value, one per line, always exit 0. Keys, all always emitted:
#   service       systemd state (active/failed/inactive/…; unknown on error)
#   netadapters   count of netadapter[-NN] jackd clients; >1 means duplicates
#   ports_wired   netadapter ports with >=1 connection
#   route         iface the 225.3.19.154 multicast group routes out of ("" if none)
#   link          up | resyncing | unknown -- see LINK_STALE_S below
#   net_restarts  netadapter link restarts since the service started
#   iface         iface the ExecStartPre pin chose ("" if /run state absent)
#   xruns_1m/5m/15m   ringbuffer xruns in the last 60/300/900 s
#
# No sudo, no writes, no restarts.

set -u

STATE=/run/jackbridge.iface
GROUP=225.3.19.154
XRUN_FILE=/tmp/pi-stomp-jackbridge.xruns
LINK_FILE=/tmp/pi-stomp-jackbridge.link

# A netadapter restart cycle repeats every few seconds while the master
# refuses the data socket. A link with no restart for this long carries
# audio again. Keep it above the retry period and below the patience of a
# user who is looking at the screen.
LINK_STALE_S=20

iface=""
[ -r "$STATE" ] && iface=$(cat "$STATE" 2>/dev/null) || true

route_dev=$(ip -o route get "$GROUP" 2>/dev/null \
    | awk '{ for (i=1; i<=NF; i++) if ($i=="dev") { print $(i+1); exit } }')

active=$(systemctl is-active pi-stomp-jackbridge.service 2>/dev/null)
[ -n "$active" ] || active=unknown

# One jack_lsp snapshot, one awk pass. Header lines are "<client>:<port>" at
# column 0; connection lines are the indented peer name itself -- jack_lsp -c
# prints "   <peer_client>:<peer_port>", with no "connected to:" prefix. An
# earlier pattern matched that prefix and so never fired, pinning ports_wired
# at 0 forever while the graph was fully wired. Track
# netadapter-ness of the current header; count distinct clients (awk assoc
# array) and wired ports (header seen + >=1 connection line) together.
read -r netadapters ports_wired <<EOF
$(JACK_PROMISCUOUS_SERVER=jack JACK_NO_START_SERVER=1 jack_lsp -c 2>/dev/null | awk '
    /^[^ \t]/ {
        split($0, a, ":");
        client = a[1];
        na = (client == "netadapter" || client ~ /^netadapter-[0-9]+$/);
        if (na) clients[client] = 1;
        next
    }
    /^[ \t]+[^ \t]/ && na { ports++ }
    END {
        n = 0;
        for (c in clients) n++;
        print n + 0, ports + 0;
    }'
)
EOF
netadapters=${netadapters:-0}
ports_wired=${ports_wired:-0}

# xrun buckets, mirroring jackbridge-xrun-watcher's "epoch_min count" lines; a
# bucket counts if its END (ts+60) falls within the window.
x1=0; x5=0; x15=0
if [ -r "$XRUN_FILE" ]; then
    now=$(date +%s)
    while read -r ts count; do
        case "$ts$count" in (*[!0-9]*|"") continue;; esac
        dt=$((now - (ts + 60)))
        [ "$dt" -lt 900 ] && x15=$((x15 + count))
        [ "$dt" -lt 300 ] && x5=$((x5 + count))
        [ "$dt" -lt 60 ]  && x1=$((x1 + count))
    done < "$XRUN_FILE"
fi

# The graph, the port count and the xrun rate all stay healthy while
# netadapter restarts its network layer in process. This is the one field
# that reports the fault.
link=unknown
net_restarts=0
if [ -r "$LINK_FILE" ]; then
    read -r last_restart net_restarts < "$LINK_FILE" || true
    case "${last_restart:-}${net_restarts:-}" in
        (*[!0-9]*|"") last_restart=""; net_restarts=0;;
    esac
    if [ -n "$last_restart" ]; then
        if [ "$last_restart" -gt 0 ] && [ $(( $(date +%s) - last_restart )) -lt "$LINK_STALE_S" ]; then
            link=resyncing
        else
            link=up
        fi
    fi
fi

printf 'service=%s\n'     "$active"
printf 'netadapters=%s\n' "$netadapters"
printf 'ports_wired=%s\n' "$ports_wired"
printf 'route=%s\n'       "$route_dev"
printf 'link=%s\n'        "$link"
printf 'net_restarts=%s\n' "$net_restarts"
printf 'iface=%s\n'       "$iface"
printf 'xruns_1m=%s\n'    "$x1"
printf 'xruns_5m=%s\n'    "$x5"
printf 'xruns_15m=%s\n'   "$x15"
exit 0
