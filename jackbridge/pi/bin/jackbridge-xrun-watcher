#!/usr/bin/env python3
"""Tails `journalctl -u jack` for netadapter ringbuffer xrun events and
maintains a bounded per-minute count file at argv[1]. It also records
netadapter link restarts to the file at argv[2]. ALSO the service's
netadapter liveness supervisor: polls the jack graph for a `netadapter`
client and exits non-zero if it disappears, so systemd (`Restart=on-failure`)
bounces the whole unit and re-wires the graph.

Why two jobs in one process: `jack_load netadapter` makes netadapter an
*in-process* client of jackd — there is no netadapter PID for MAINPID to
track. The graph is the only ground truth for "is the slave still loaded",
and the graph is cheap to poll from the same event loop that already runs
here. Making this file the unit's long-running foreground process keeps
MAINPID truthful: process alive ⇔ slave loaded + xrun telemetry flowing.

Why the link file: netadapter restarts its network layer *in process* on a
lost stream. The JACK client and its ports survive, so the graph, the port
count, the route and the xrun rate all still say "healthy" while no audio
crosses the wire. This journal line is the only pi-side evidence.

File format: 15 lines, oldest first, each "<epoch_sec_of_minute> <count>".
The link file is one line, "<epoch_of_last_restart> <restarts_since_start>",
with 0 0 until the first restart.
Consumer (pi-stomp modalapi/ethernet/manager.py read_xrun_buckets) sums the
count column over the slice whose epoch is within 60/300/900s of now.

Why per-minute buckets and not per-event timestamps: a previous version
appended one line per xrun and rewrote-on-rename per event. Under load that
pegged a core, starved jackd, and amplified the xrun rate it was measuring.
Per-minute buckets bound the work to one int increment per event and at most
one file write per second regardless of xrun rate.
"""

import os
import re
import select
import subprocess
import sys
import tempfile
import time

# How often to check the jack graph for a live `netadapter` client. jack_lsp
# joins and leaves the RT graph per call, so 5 Hz would be obnoxious; 0.5 Hz
# detects an unload within ~2 s while adding < 1% CPU. Worst-case time-to-
# restart is bounded by systemd's RestartSec, not by this interval.
LIVENESS_INTERVAL_S = 2.0

_LSP_ENV = {
    **os.environ,
    "JACK_PROMISCUOUS_SERVER": "jack",
    "JACK_NO_START_SERVER": "1",
}


def netadapter_present() -> bool:
    """True if any client named netadapter (or netadapter-NN) is in the graph."""
    try:
        out = subprocess.check_output(
            ["jack_lsp", "-l"], env=_LSP_ENV, text=True, timeout=5
        )
    except Exception:
        # jackd unreachable / busy — treat as "gone" so the unit restarts and
        # re-wires once jackd is healthy, rather than supervising a dead graph.
        return False
    for line in out.splitlines():
        # Lines are "<client>:<port>" at column 0; port metadata is indented.
        if line and not line[:1].isspace():
            client = line.split(":", 1)[0]
            if client == "netadapter" or re.fullmatch(r"netadapter-\d+", client):
                return True
    return False

N_BUCKETS = 15  # 15 one-minute buckets = 15-minute window

PATTERN = re.compile(r"JackRingBuffer::(Read|Write)\b.*\b(producer|consumer) too slow")

# One line per restart cycle. The "connection lost" lines that precede it are
# not counted -- a cycle emits several of them and one restart.
LINK_PATTERN = re.compile(r"NetAdapter is restarted")


def write_file(path: str, buckets: list[int], cur_min: int) -> None:
    """Atomic rewrite: 15 lines, oldest minute first."""
    dirpath = os.path.dirname(path) or "."
    fd, tmp = tempfile.mkstemp(dir=dirpath, prefix=".xruns-")
    try:
        with os.fdopen(fd, "w") as f:
            for i in range(N_BUCKETS):
                m = cur_min - (N_BUCKETS - 1) + i
                f.write(f"{m * 60} {buckets[m % N_BUCKETS]}\n")
        os.rename(tmp, path)
    except Exception:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def log(msg: str) -> None:
    """One line to stderr, which systemd routes to the unit's journal.

    Every caller is on the 1 Hz loop or rarer. Never log per xrun: the
    previous version of this script wrote per event, pegged a core, starved
    jackd, and amplified the very xrun rate it was measuring.
    """
    print(f"jackbridge-xrun-watcher: {msg}", file=sys.stderr, flush=True)


def write_link(path: str, last_restart: int, restarts: int) -> None:
    """Atomic rewrite: one line, "<epoch_of_last_restart> <restarts>"."""
    dirpath = os.path.dirname(path) or "."
    fd, tmp = tempfile.mkstemp(dir=dirpath, prefix=".link-")
    try:
        with os.fdopen(fd, "w") as f:
            f.write(f"{last_restart} {restarts}\n")
        os.rename(tmp, path)
    except Exception:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def main() -> int:
    if len(sys.argv) != 3:
        print(
            "usage: jackbridge-xrun-watcher <path-to-xrun-file> <path-to-link-file>",
            file=sys.stderr,
        )
        return 2
    path = sys.argv[1]
    link_path = sys.argv[2]

    proc = subprocess.Popen(
        ["journalctl", "-u", "jack", "-f", "-o", "cat", "-n", "0"],
        stdout=subprocess.PIPE,
        text=True,
        bufsize=1,
    )

    # A restart total that survived a watcher crash would read as a fault
    # that is over. Start from zero and say so.
    restarts = 0
    write_link(link_path, 0, 0)
    log(f"watching jack journal; xruns -> {path}, link -> {link_path}")

    buckets = [0] * N_BUCKETS
    cur_min = int(time.time()) // 60
    dirty = True
    last_flush = 0.0
    last_liveness = 0.0  # force a graph check on the first loop iteration

    try:
        assert proc.stdout is not None
        while True:
            ready, _, _ = select.select([proc.stdout], [], [], 1.0)
            now = time.time()
            now_min = int(now) // 60

            # Liveness supervision. Runs on the same 1 Hz loop tick; the
            # interval check keeps us off the RT graph except twice a minute.
            if now - last_liveness >= LIVENESS_INTERVAL_S:
                last_liveness = now
                if not netadapter_present():
                    print(
                        "jackbridge-xrun-watcher: netadapter client absent — "
                        "exiting non-zero so systemd restarts the unit",
                        file=sys.stderr,
                    )
                    # Exit code 1 (not 0) so Restart=on-failure fires; plain
                    # clean exits (0/SUCCESS) would not trigger a bounce.
                    return 1

            # Advance the window; zero out any minute buckets we've crossed.
            if now_min != cur_min:
                # Summarise the minute that just closed, and only when it was
                # not clean. A quiet link stays quiet in the journal, so a
                # single line here always means something happened.
                closed = buckets[cur_min % N_BUCKETS]
                if closed:
                    log(f"{closed} ringbuffer xrun(s) in the last minute")
                for m in range(cur_min + 1, now_min + 1):
                    buckets[m % N_BUCKETS] = 0
                cur_min = now_min
                dirty = True

            if ready:
                line = proc.stdout.readline()
                if not line:
                    # journalctl exited. Returning 0 here let the unit stop
                    # without tripping Restart=on-failure: telemetry died, the
                    # slave kept running, and pi-status went on reporting the
                    # last xrun buckets as though they were current. Fail
                    # loudly instead, so systemd re-establishes the watch.
                    log("WARNING journalctl exited; xrun telemetry has stopped")
                    return 1
                if PATTERN.search(line):
                    buckets[cur_min % N_BUCKETS] += 1
                    dirty = True
                elif LINK_PATTERN.search(line):
                    # Restarts arrive at most every few seconds, so this write
                    # needs no rate limit of its own.
                    restarts += 1
                    write_link(link_path, int(now), restarts)
                    # netadapter restarts its network layer in process. The
                    # JACK client, its ports, the route and the xrun rate all
                    # still read healthy while no audio crosses the wire, so
                    # this line is the only pi-side evidence of the gap.
                    log(f"netadapter link restarted (restart #{restarts})")

            # Flush at most once per second. Bounds filesystem work no matter
            # how fast xruns arrive — the bug this script's previous version
            # caused was unbounded per-event writes.
            if dirty and now - last_flush >= 1.0:
                write_file(path, buckets, cur_min)
                dirty = False
                last_flush = now
    finally:
        proc.terminate()
    return 0


if __name__ == "__main__":
    sys.exit(main())
