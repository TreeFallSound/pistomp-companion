#!/bin/sh
# jackbridge-ctl — user-facing start/stop/status for the JackBridge daemons.
#
# Wraps `launchctl` against /Library/LaunchAgents/com.treefallsound.companion.{jackd,daemon}.
# Both agents move together (stopping only one leaves either the audio device
# orphaned or the daemon crash-looping). Also drives the pi-side
# pi-stomp-jackbridge.service over ssh, so a single `start`/`stop` brings the
# whole recording link up/down on both ends.
#
# Usage:
#   jackbridge-ctl start
#   jackbridge-ctl stop
#   jackbridge-ctl restart
#   jackbridge-ctl status
#   jackbridge-ctl pi-status       # key=value truth from the pi (jackbridge-pi-status)
#   jackbridge-ctl logs            # tail -f the agent log files
#
# Maintainer only (not in the Companion menu):
#   jackbridge-ctl repair          # bounce coreaudiod + the plug-in host + both agents.
#                                 # Runs `sudo killall`; needs a real terminal for the
#                                 # password — never invoke it from a GUI context.
#
# Runs as the logged-in user (no sudo needed). LaunchAgent disabled-state
# persists across reboots via /var/db/com.apple.xpc.launchd/disabled.<uid>.plist
# so `stop` survives a reboot and `start` re-enables.

set -e

LAGENTS="/Library/LaunchAgents"
LABELS="com.treefallsound.companion.jackd com.treefallsound.companion.daemon"
UID_NUM=$(/usr/bin/id -u)
DOMAIN="gui/$UID_NUM"
LOG_DIR="/tmp"
SUPPORT="/Library/Application Support/JackBridge"
OWNER_HELPER="$SUPPORT/jackbridge-jackd"
STATUS_FILE="${JACKBRIDGE_STATUS_FILE:-/tmp/jackbridge-jackd.status}"
PREFIX_HELPER="$SUPPORT/jack-prefix.sh"
SSH="${JACKBRIDGE_SSH_PATH:-/usr/bin/ssh}"
PI_HOST="${JACKBRIDGE_PI_HOST:-pistomp.local}"
PI_USER="pistomp"
PI_SERVICE="pi-stomp-jackbridge"
PI_STATUS_BIN="/usr/local/libexec/jackbridge/jackbridge-pi-status"
if [ -r "$PREFIX_HELPER" ]; then
    . "$PREFIX_HELPER"
else
    JACK_LSP="/usr/local/bin/jack_lsp"
fi

owned_jackd_pids() {
    [ -x "$OWNER_HELPER" ] || return 0
    "$OWNER_HELPER" owned-pids "$UID_NUM" 2>/dev/null || true
}

refresh_jack_status() {
    [ -x "$OWNER_HELPER" ] || return 0
    case $("$OWNER_HELPER" state "$JACK_LSP" "$UID_NUM" 2>/dev/null || printf '%s' none) in
        foreign)
            tmp="${STATUS_FILE}.$$"
            printf '%s\n' foreign > "$tmp"
            /bin/mv -f "$tmp" "$STATUS_FILE"
            ;;
        *) /bin/rm -f "$STATUS_FILE" ;;
    esac
}
# Run a command on the pi over ssh. Same BatchMode/timeout discipline the
# app's probe (SettingsWindowController.swift:375-381) and the coordinator
# (jackbridge-coordinator:91) already use — the guided first-run key setup on
# the Mac is what makes all three work. Non-zero return = any failure.
pi_ssh() {
    "$SSH" -o BatchMode=yes -o ConnectTimeout=5 -o ConnectionAttempts=1 \
        "$PI_USER@$PI_HOST" "$@"
}

# True when the pi answers ssh and has the status script. Cheap; the ~5 s
# ConnectTimeout only fires on a genuinely dead pi, and the verbs that call
# this already take seconds.
pi_reachable() {
    pi_ssh "test -x $PI_STATUS_BIN" >/dev/null 2>&1
}

# Drive the pi's service in the given direction. Best-effort with a warning:
# the Mac jackd works recording nothing, and an unreachable pi must never
# block a local restart (e.g. cable temporarily out).
pi_service() {
    verb="$1"  # start | stop
    if pi_reachable; then
        if pi_ssh "sudo systemctl $verb $PI_SERVICE" >/dev/null 2>&1; then
            echo "pi: systemctl $verb $PI_SERVICE ok"
        else
            echo "warning: pi $verb of $PI_SERVICE failed (pi reachable, systemctl returned non-zero)" >&2
        fi
    else
        echo "warning: pi unreachable at $PI_USER@$PI_HOST — skipping pi-side $verb" >&2
    fi
}

cmd_pi_status() {
    if ! pi_reachable; then
        echo "pi unreachable: ssh $PI_USER@$PI_HOST (key install? cable? wifi?)" >&2
        exit 1
    fi
    pi_ssh "$PI_STATUS_BIN"
}

agent_loaded() {
    /bin/launchctl print "$DOMAIN/$1" >/dev/null 2>&1
}

bootstrap_agent() {
    label="$1"
    plist="$LAGENTS/$label.plist"
    if agent_loaded "$label"; then
        return 0
    fi
    /bin/launchctl bootstrap "$DOMAIN" "$plist" 2>/dev/null || {
        # A route watcher can bootstrap the same agent concurrently. Accept
        # that race only when the agent is actually present afterwards.
        agent_loaded "$label" || {
            echo "error: could not bootstrap $label" >&2
            return 1
        }
    }
}
usage() {
    sed -n '3,22p' "$0" | sed 's/^# \{0,1\}//'
    exit 2
}

cmd_start() {
    for label in $LABELS; do
        /bin/launchctl enable "$DOMAIN/$label" 2>/dev/null || true
    done
    # Bootstrap jackd first so the daemon's first connect attempt finds it.
    for label in $LABELS; do
        plist="$LAGENTS/$label.plist"
        if [ ! -f "$plist" ]; then
            echo "error: $plist not found — is JackBridge installed?" >&2
            exit 1
        fi
        bootstrap_agent "$label"
    done

    # The Mac owns the bridge lifecycle end to end — bring the pi slave up in
    # the same verb so the user sees one success, not "Mac up, pi forgot".
    pi_service start

    echo "started: $LABELS"
}

cmd_stop() {
    # Tear the slave down first. The fork's master-dedupe would reap a leaked
    # netadapter anyway, but there is no reason to keep the pi sending into a
    # Mac that is going away. Best-effort; unreachable pi must not block stop.
    pi_service stop

    started=0
    for label in $LABELS; do
        if agent_loaded "$label"; then started=1; fi
    done
    if [ "$started" -eq 0 ] && \
       ! /usr/bin/pgrep -x -U "$UID_NUM" JackBridged >/dev/null && \
       [ -z "$(owned_jackd_pids)" ]; then
        refresh_jack_status
        echo "already stopped: $LABELS"
        return 0
    fi
    # Daemon first so it doesn't crash-loop while jackd is going away.
    for label in com.treefallsound.companion.daemon com.treefallsound.companion.jackd; do
        /bin/launchctl bootout "$DOMAIN/$label" 2>/dev/null || true
        /bin/launchctl disable "$DOMAIN/$label" 2>/dev/null || true
    done
    # bootout returns before the process is actually reaped. Only kill
    # jackd processes carrying JackBridge's environment mark; a JACK server
    # owned by another program must survive `stop` and `restart`.
    for i in 1 2 3 4 5 6; do
        if ! /usr/bin/pgrep -x -U "$UID_NUM" JackBridged >/dev/null && \
           [ -z "$(owned_jackd_pids)" ]; then
            break
        fi
        sleep 0.5
    done
    /usr/bin/pkill -9 -x -U "$UID_NUM" JackBridged 2>/dev/null || true
    for pid in $(owned_jackd_pids); do
        /bin/kill -9 "$pid" 2>/dev/null || true
    done
    refresh_jack_status
    echo "stopped: $LABELS"
}

cmd_status() {
    for label in $LABELS; do
        line=$(/bin/launchctl print "$DOMAIN/$label" 2>/dev/null | awk '/^\tstate = / {print $3; exit}')
        if [ -z "$line" ]; then
            line="not loaded"
        fi
        printf "%-30s %s\n" "$label" "$line"
    done
}
# `repair` is the heavy, sure-fire re-anchor: bounce coreaudiod (the only
# place the plug-in's shm region is created / device name rebuilt), then the
# two agents. Maintainer-only since Task C (docs/plan-replug-recovery.md):
# the Companion menu no longer offers it, because its `sudo killall` calls
# fail without a terminal for the password and what remains — kickstart the
# two agents, start the pi service — is exactly `jackbridge-ctl restart`.
#
# Order matters: coreaudiod first. The plug-in creates the shm region in
# _HW_Open, which only runs when the plug-in loads — a bare `killall` leaves
# the region absent until something enumerates devices, which is the
# system_profiler call below. Then jackd before daemon because JackBridged
# exits 1 on a failed jack_client_open and launchd answers with
# ThrottleInterval, not a useful error. Mirrors the justfile restart recipe
# (which is also what `just reload` composes).
cmd_repair() {
    echo "repair: bouncing coreaudiod + JackBridge agents"
    /usr/bin/sudo /usr/bin/killall coreaudiod || true
    /usr/bin/sudo /usr/bin/killall "Core Audio Driver (JackBridgePlugIn.driver)" || true
    /bin/sleep 2
    # Force the plug-in to load so the shm region exists again.
    /usr/sbin/system_profiler SPAudioDataType >/dev/null 2>&1 || true
    /bin/launchctl kickstart -k "$DOMAIN/com.treefallsound.companion.jackd"   || true
    /bin/launchctl kickstart -k "$DOMAIN/com.treefallsound.companion.daemon" || true
    pi_service start   # bring the slave up too; repair implies "want audio"
    echo "repair: agents kicked; give it a few seconds, then check: jackbridge-ctl status && jackbridge-ctl pi-status"
}

cmd_logs() {
    files="$LOG_DIR/com.treefallsound.companion.jackd.err.log $LOG_DIR/com.treefallsound.companion.jackd.out.log \
           $LOG_DIR/com.treefallsound.companion.daemon.err.log $LOG_DIR/com.treefallsound.companion.daemon.out.log"
    # tail -F follows files that don't exist yet — handy if the daemon hasn't
    # been started since boot.
    exec /usr/bin/tail -F $files
}

case "${1:-}" in
    start)     cmd_start ;;
    stop)      cmd_stop ;;
    restart)   cmd_stop; cmd_start ;;
    status)    cmd_status ;;
    pi-status) cmd_pi_status ;;
    repair)    cmd_repair ;;
    logs)      cmd_logs ;;
    *)         usage ;;
esac
