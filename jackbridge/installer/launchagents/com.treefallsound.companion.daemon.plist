<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.treefallsound.companion.daemon</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Library/Application Support/JackBridge/JackBridged</string>
    </array>

    <!--
        The Companion GUI owns this agent. Disabled=true prevents launchd
        from starting it at login; jackbridge-ctl start explicitly enables
        and bootstraps it. KeepAlive provides crash recovery only while the
        GUI-owned job is enabled.
    -->
    <key>Disabled</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>2</integer>

    <key>LimitLoadToSessionType</key>
    <string>Aqua</string>
    <key>ProcessType</key>
    <string>Interactive</string>
    <key>WatchPaths</key>
    <array>
        <string>@HOME_CONFIG@</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>JACKBRIDGE_CONFIG_PATH</key>
        <string>@CONFIG_PATH@</string>
    </dict>
    <key>StandardOutPath</key>
    <string>/tmp/com.treefallsound.companion.daemon.out.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/com.treefallsound.companion.daemon.err.log</string>
</dict>
</plist>
