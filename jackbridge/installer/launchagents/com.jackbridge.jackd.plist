<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.jackbridge.jackd</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Library/Application Support/JackBridge/jackd-launch</string>
    </array>

    <!--
        Lifecycle is managed by the route daemon (com.jackbridge.route),
        which calls launchctl enable+bootstrap on this agent when wired
        ethernet is up, and launchctl bootout+disable when it isn't.
        PathState was the obvious-looking alternative but it only governs
        whether launchd restarts on exit — it does not actively SIGTERM a
        running job when the file disappears, so jackd would silently keep
        running on a now-wifi route.

        KeepAlive=true gives us crash recovery (e.g. SIGKILL from `kill -9`).
        RunAtLoad intentionally absent: the postinstall bootstraps this
        agent, not RunAtLoad. ThrottleInterval=2s bounds the crash-recovery
        restart rate.
    -->
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>2</integer>

    <key>LimitLoadToSessionType</key>
    <string>Aqua</string>
    <key>ProcessType</key>
    <string>Interactive</string>
    <key>StandardOutPath</key>
    <string>/tmp/com.jackbridge.jackd.out.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/com.jackbridge.jackd.err.log</string>

    <!-- Restart jackd when config.plist changes (e.g. ClockDeviceUID edit). -->
    <key>WatchPaths</key>
    <array>
        <string>/Library/Application Support/JackBridge/config.plist</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
</dict>
</plist>
