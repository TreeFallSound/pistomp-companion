<?xml version="1.0" encoding="utf-8" standalone="no"?>
<installer-gui-script minSpecVersion="2">
    <title>PiStomp Companion</title>
    <organization>treefallsound</organization>
    <options customize="never" require-scripts="true" hostArchitectures="arm64"/>
    <volume-check>
        <allowed-os-versions>
            <os-version min="13.0"/>
        </allowed-os-versions>
    </volume-check>
    <installation-check script="installation_check()"/>
    <script><![CDATA[
// @JACK_PREFIX@ is substituted by build-pkg.sh from $JACK_PREFIX, the same
// value stamped into config.plist as JackPrefix. Hardcoding /usr/local here
// made a JACK_PREFIX=/opt/homebrew build refuse to install on a machine that
// had JACK2 -- see the "One JACK prefix, stamped at build time" rule.
//
// Note this can only check presence and version: the sastraxi/jack2 fork
// reports the same 'jackdmp version 1.9.22' as stock upstream, so a user who
// installed stock JACK2 passes this check and then hits a silent netJACK2
// discovery timeout for want of the multicast pin.
function installation_check() {
    var minVersion = '1.9.22';
    var jackPrefix = '@JACK_PREFIX@';
    var jackd = jackPrefix + '/bin/jackd';
    var releases = 'https://github.com/treefallsound/pistomp-companion/releases';

    if (!system.files.fileExistsAtPath(jackd)) {
        my.result.title = 'JACK2 is required';
        my.result.message = 'PiStomp Companion requires JACK2 ' + minVersion + ' or newer ' +
            'at ' + jackPrefix + '. Install the jack2-<version>.pkg from ' + releases +
            ' and then run this installer again. Note this must be the forked build ' +
            'published there -- stock JACK2 lacks the netJACK2 multicast-interface ' +
            'pin, and discovery will time out without it.';
        my.result.type = 'Fatal';
        return false;
    }

    var out = system.run(jackd, '--version') || '';
    var m = out.match(/jackdmp version ([0-9]+)\.([0-9]+)\.([0-9]+)/);
    if (m) {
        var have = [parseInt(m[1],10), parseInt(m[2],10), parseInt(m[3],10)];
        var need = minVersion.split('.').map(function(n){return parseInt(n,10);});
        for (var i = 0; i < 3; i++) {
            if (have[i] > need[i]) break;
            if (have[i] < need[i]) {
                my.result.title = 'JACK2 is too old';
                my.result.message = 'Found jackd ' + have.join('.') +
                    ' at ' + jackd + '. PiStomp Companion requires ' + minVersion +
                    ' or newer. Reinstall the jack2-<version>.pkg from ' + releases + '.';
                my.result.type = 'Fatal';
                return false;
            }
        }
    }

    return true;
}
    ]]></script>
    <domains enable_localSystem="true"/>
    <choices-outline>
        <line choice="default">
            <line choice="com.treefallsound.companion"/>
        </line>
    </choices-outline>
    <choice id="default"/>
    <choice id="com.treefallsound.companion" visible="false">
        <pkg-ref id="com.treefallsound.companion"/>
    </choice>
    <pkg-ref id="com.treefallsound.companion" version="@VERSION@" onConclusion="none">PiStompCompanion-component.pkg</pkg-ref>
</installer-gui-script>
