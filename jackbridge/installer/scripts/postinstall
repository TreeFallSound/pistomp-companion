#!/bin/sh
# JackBridge postinstall: install the HAL, seed the active user's home
# configuration, and leave JACK stopped until the Companion GUI starts it.
set -e

/usr/bin/killall coreaudiod 2>/dev/null || true

SUPPORT="/Library/Application Support/JackBridge"
DEFAULT="$SUPPORT/config.plist.default"
loggedInUser=$(/usr/bin/stat -f%Su /dev/console 2>/dev/null || true)
homeConfig=""
loggedInUID=""
if [ -n "$loggedInUser" ] && [ "$loggedInUser" != root ]; then
    loggedInUID=$(/usr/bin/id -u "$loggedInUser")
    userHome=$(/usr/bin/dscl . -read "/Users/$loggedInUser" NFSHomeDirectory 2>/dev/null | \
        /usr/bin/awk '{print $2}')
    userHome=${userHome:-/Users/$loggedInUser}
    homeConfig="$userHome/Library/Application Support/JackBridge/config.plist"
    homeDir=$(/usr/bin/dirname "$homeConfig")
    /bin/mkdir -p "$homeDir"
    /usr/sbin/chown "$loggedInUser":staff "$userHome/Library/Application Support" "$homeDir" 2>/dev/null || true
    /bin/chmod 700 "$userHome/Library/Application Support" "$homeDir" 2>/dev/null || true
    if [ ! -f "$homeConfig" ] && [ -f "$DEFAULT" ]; then
        /bin/cp "$DEFAULT" "$homeConfig"
        /usr/sbin/chown "$loggedInUser":staff "$homeConfig"
        /bin/chmod 600 "$homeConfig"
    fi
fi

# Launchd watches the resolved home path, never a tilde or unresolved token.
# If installation occurs at the login window, /var/empty intentionally keeps
# the agents dormant; the route watcher resolves the active user dynamically.
watchPath=${homeConfig:-/var/empty/jackbridge-config.plist}
for plist in \
    /Library/LaunchAgents/com.jackbridge.daemon.plist \
    /Library/LaunchAgents/com.jackbridge.jackd.plist \
    /Library/LaunchDaemons/com.jackbridge.route.plist; do
    if [ -f "$plist" ]; then
        tmp="$plist.$$"
        /usr/bin/sed -e "s|@HOME_CONFIG@|$watchPath|g" \
            -e "s|@CONFIG_PATH@|$watchPath|g" "$plist" > "$tmp"
        /usr/sbin/chown root:wheel "$tmp"
        /bin/chmod 644 "$tmp"
        /bin/mv -f "$tmp" "$plist"
    fi
done

ROUTE_LABEL=com.jackbridge.route
ROUTE_PLIST=/Library/LaunchDaemons/$ROUTE_LABEL.plist
if [ -f "$ROUTE_PLIST" ]; then
    /bin/launchctl bootout "system/$ROUTE_LABEL" 2>/dev/null || true
    /bin/launchctl enable "system/$ROUTE_LABEL" 2>/dev/null || true
    /bin/launchctl bootstrap system "$ROUTE_PLIST" || true
fi

/bin/mkdir -p /usr/local/bin
/bin/ln -sf "$SUPPORT/jackbridge-ctl" /usr/local/bin/jackbridge-ctl
OWNER_HELPER="$SUPPORT/jackbridge-jackd"
STATUS_FILE="${JACKBRIDGE_STATUS_FILE:-/tmp/jackbridge-jackd.status}"
owned_jackd_pids() {
    [ -x "$OWNER_HELPER" ] || return 0
    "$OWNER_HELPER" owned-pids "$loggedInUID" 2>/dev/null || true
}

if [ -n "$loggedInUID" ]; then
    for label in com.jackbridge.daemon com.jackbridge.jackd; do
        /bin/launchctl bootout "gui/$loggedInUID/$label" 2>/dev/null || true
        /bin/launchctl disable "gui/$loggedInUID/$label" 2>/dev/null || true
    done
    for i in 1 2 3 4 5 6; do
        if ! /usr/bin/pgrep -x -U "$loggedInUID" JackBridged >/dev/null && \
           [ -z "$(owned_jackd_pids)" ]; then break; fi
        /bin/sleep 0.5
    done
    /usr/bin/pkill -9 -x -U "$loggedInUID" JackBridged 2>/dev/null || true
    for pid in $(owned_jackd_pids); do /bin/kill -9 "$pid" 2>/dev/null || true; done
    /bin/rm -f "$STATUS_FILE"
fi
exit 0
