#!/bin/sh
# Pin the netJACK2 multicast group (225.3.19.154) to the interface our
# auto-detector picks. Runs as root via the com.jackbridge.route LaunchDaemon.
#
# Idempotent: deletes any prior host route for the group, then re-adds. The
# kernel uses the resulting route to choose which iface to IP_ADD_MEMBERSHIP
# on when netmanager (loaded inside the user-session jackd) binds the group.
#
# Config: reads the active user's generated home plist.
set -eu

SUPPORT="/Library/Application Support/JackBridge"
CONFIG="${JACKBRIDGE_CONFIG_PATH:-$HOME/Library/Application Support/JackBridge/config.plist}"
console_user=$(/usr/bin/stat -f%Su /dev/console 2>/dev/null || true)
if [ -n "$console_user" ] && [ "$console_user" != root ]; then
    console_home=$(/usr/bin/dscl . -read "/Users/$console_user" NFSHomeDirectory 2>/dev/null | /usr/bin/awk '{print $2}')
    [ -n "$console_home" ] && CONFIG="$console_home/Library/Application Support/JackBridge/config.plist"
fi
DETECT="$SUPPORT/jb-detect-net-iface"
STATE=/var/run/jackbridge-route.iface
GROUP=225.3.19.154

OVERRIDE=""
if [ -f "$CONFIG" ]; then
    OVERRIDE=$(/usr/libexec/PlistBuddy -c "Print :NetworkInterface" "$CONFIG" 2>/dev/null || true)
fi
case "$OVERRIDE" in
    *[!A-Za-z0-9_.-]*) echo "jackbridge-pin-route: invalid NetworkInterface" >&2; exit 1 ;;
esac
iface=$("$DETECT" "$OVERRIDE") || {
    echo "jackbridge-pin-route: no usable interface, leaving multicast route alone." >&2
    exit 1
}

# Drop any stale route, then add. Ignore the delete's exit code — the route
# may not exist on first run.
/sbin/route -n delete -host "$GROUP" >/dev/null 2>&1 || true
/sbin/route -n add -host "$GROUP" -interface "$iface" >/dev/null

mkdir -p "$(dirname "$STATE")"
echo "$iface" > "$STATE"
echo "jackbridge-pin-route: pinned $GROUP to $iface" >&2
