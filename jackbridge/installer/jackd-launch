#!/bin/sh
# JackBridge JACK LaunchAgent entrypoint. Normal startup delegates timing
# discovery to jackbridge-coordinator; --launch-jack is its internal path.
set -u
export JACK_NO_START_SERVER=1

SUPPORT="/Library/Application Support/JackBridge"
OWNER_HELPER="$SUPPORT/jackbridge-jackd"
STATUS_FILE="${JACKBRIDGE_STATUS_FILE:-/tmp/jackbridge-jackd.status}"
ROUTE_STATE=/var/run/jackbridge-route.iface
ETHERNET_SENTINEL=/var/run/jackbridge-ethernet.up

write_status() {
    tmp="${STATUS_FILE}.$$"
    printf '%s\n' "$1" > "$tmp"
    /bin/mv -f "$tmp" "$STATUS_FILE"
}
clear_status() { /bin/rm -f "$STATUS_FILE"; }

# The wired interface the netJACK2 multicast group is pinned to, or failure
# when there is not one. Both files are written by jackbridge-route-watcher:
# it touches the sentinel only for a wired or direct-cable interface and
# removes it on wifi-only or no-network, so the sentinel is already the
# watcher's own "not Wi-Fi" verdict and this script does not repeat the
# heuristic. Together they are the one predicate for "netJACK2 can reach
# the pi at all".
wired_iface() {
    [ -f "$ETHERNET_SENTINEL" ] || return 1
    _iface=$(/bin/cat "$ROUTE_STATE" 2>/dev/null) || return 1
    [ -n "$_iface" ] || return 1
    printf '%s\n' "$_iface"
}

# These two must match StandardOutPath / StandardErrorPath in
# com.treefallsound.companion.jackd.plist.
LOG_ERR="${JACKBRIDGE_LOG_ERR:-/tmp/com.treefallsound.companion.jackd.err.log}"
LOG_OUT="${JACKBRIDGE_LOG_OUT:-/tmp/com.treefallsound.companion.jackd.out.log}"
LOG_MAX_BYTES=8388608
LOG_KEEP_LINES=20000

# launchd opens the redirect O_APPEND and hands the descriptor down to every
# child, so the writer holds the inode and not the name. Renaming the file —
# what newsyslog and logrotate do — leaves jackd writing into the renamed
# copy while the fresh one stays empty forever. Emptying in place is the only
# thing that works here, and O_APPEND is what makes it safe: the next write
# recomputes its offset to EOF instead of leaving a multi-megabyte hole.
# Nothing else ever resets these files, so without this they only grow.
cap_log() {
    [ -f "$1" ] || return 0
    size=$(/usr/bin/stat -f%z "$1" 2>/dev/null) || return 0
    [ "$size" -gt "$LOG_MAX_BYTES" ] || return 0
    /usr/bin/tail -n "$LOG_KEEP_LINES" "$1" > "$1.prev" 2>/dev/null || true
    : > "$1"
    echo "jackd-launch: $1 passed $LOG_MAX_BYTES bytes; tail kept in $1.prev" >&2
}
PREFIX_HELPER="$SUPPORT/jack-prefix.sh"
if [ -r "$PREFIX_HELPER" ]; then
    . "$PREFIX_HELPER"
else
    JACK_PREFIX=/usr/local
    JACKD="$JACK_PREFIX/bin/jackd"
    JACK_LOAD="$JACK_PREFIX/bin/jack_load"
    JACK_LSP="$JACK_PREFIX/bin/jack_lsp"
fi

# Gate. netJACK2 does not reach the pi over Wi-Fi, and netmanager binds
# JACK_NETJACK_MULTICAST_IF once, when it loads. Starting before the route
# watcher has pinned a wired interface therefore yields a JACK server that
# looks entirely healthy and silently never sees the pi -- the ports never
# appear and the menu just says "not in JACK graph". Waiting is the honest
# behaviour, and it must happen before the coordinator too: that probes the
# pi over the network for its timing and falls back to stale cached values
# when the link is not up yet.
#
# A second layer was added for the replug fault (docs/plan-replug-recovery.md,
# Correction 2a): the sentinel and the route file both become true the moment
# the link comes up, but a freshly plugged link-local interface cannot carry
# data yet -- no address, or an ARP cache still pointing at the pre-unplug
# entry. Starting jackd in that window loads netmanager against an interface
# whose unicast path is dead, and every later handshake then fails with
# ECONNREFUSED on the master side (fault 2). The fix is to make the gate wait
# until the pi actually answers, with a bound: a jackd that records nothing is
# worse than one that starts and fails loudly.
#
# Probe choice: one ICMP echo, 2 s timeout, via the configured pi hostname
# (the same name netJACK2 and the daemon connect to). Ping is cheap, needs no
# privileges, and exercises exactly the unicast path the handshake uses. It
# cannot use jackbridge-coordinator's ssh probe: that runs *after* this gate,
# and a failed probe there silently falls back to stale cached timing.

# The configured pi hostname, or the shipped default. Mirrors the reader in
# jackbridge-coordinator (PlistBuddy against the user config, then the
# system default) and pi-hostname.sh.
pi_hostname() {
    _user_home=$(/usr/bin/stat -f%Su /dev/console 2>/dev/null || true)
    _config=""
    if [ -n "$_user_home" ] && [ "$_user_home" != root ]; then
        _home=$(/usr/bin/dscl . -read "/Users/$_user_home" NFSHomeDirectory 2>/dev/null | /usr/bin/awk '{print $2}')
        [ -n "$_home" ] && _config="$_home/Library/Application Support/JackBridge/config.plist"
    fi
    [ -r "$_config" ] || _config="$HOME/Library/Application Support/JackBridge/config.plist"
    if [ -r "$_config" ]; then
        _host=$(/usr/libexec/PlistBuddy -c "Print :PiHostname" "$_config" 2>/dev/null) || _host=""
        case "$_host" in
            *[!A-Za-z0-9._:%-]*|"") ;;
            *) printf '%s\n' "$_host"; return 0 ;;
        esac
    fi
    printf '%s\n' "pistomp.local"
}

# Bounded wait, then start anyway. jackd that records nothing is worse than
# jackd that fails in its own log.
LINK_WAIT_LIMIT="${JACKBRIDGE_LINK_WAIT_LIMIT:-60}"

# True when the kernel knows a link-local peer on the wired interface. This is
# the condition the handshake needs: an address that ARP can resolve to a MAC
# that is not ours. jackbridge-route-watcher removes these entries on each
# network change, and writes the pi's again when it hears the pi announce.
# Thus an entry that is present now is also current.
#
# Do not test for "permanent". The watcher's static entry has that flag, but a
# normal learned entry does not, and both are sufficient. Our own address also
# has the flag, on lo0.
peer_pinned() {
    _mac=$(/sbin/ifconfig "$1" 2>/dev/null | /usr/bin/awk '/[ \t]ether /{print $2; exit}')
    /usr/sbin/arp -an 2>/dev/null | /usr/bin/awk -v ifc="$1" -v me="$_mac" '
        $0 !~ ("on " ifc " ") { next }
        $2 !~ /\(169\.254\./ { next }
        $2 ~ /\(169\.254\.255\.255\)/ { next }
        $4 == "ff:ff:ff:ff:ff:ff" { next }
        me != "" && $4 == me { next }
        { found = 1 }
        END { exit !found }'
}

wait_for_pi() {
    _host=$(pi_hostname)
    _deadline=$(( $(/bin/date +%s) + LINK_WAIT_LIMIT ))
    while :; do
        # The ping stays as the fallback. It is the only probe on a network
        # that gives the pi a routed address, where no peer is ever pinned.
        if peer_pinned "$WIRED_IFACE" || /sbin/ping -c 1 -t 2 -n "$_host" >/dev/null 2>&1; then
            return 0
        fi
        [ "$( /bin/date +%s )" -lt "$_deadline" ] || {
            echo "jackd-launch: no pi on $WIRED_IFACE and no ping answer from $_host within ${LINK_WAIT_LIMIT}s; starting anyway" >&2
            return 1
        }
        sleep 2
    done
}

WIRED_IFACE=$(wired_iface || true)
if [ -z "$WIRED_IFACE" ]; then
    write_status waiting-network
    echo "jackd-launch: waiting for a wired connection to the pi" >&2
    while [ -z "$WIRED_IFACE" ]; do
        sleep 2
        WIRED_IFACE=$(wired_iface || true)
    done
    clear_status
    echo "jackd-launch: wired connection up on $WIRED_IFACE" >&2
fi

# The handshake needs the pi's unicast path alive, not only the interface
# present. Wait for the pi, with a bound.
#
# Do this one time. jackbridge-coordinator starts this script again with
# --launch-jack, and a gate above that branch ran in both processes. Each run
# waits the full limit when the pi is absent, thus a replug paid the limit two
# times: 120 s of the 140 s recovery, measured 2026-08-29.
if [ "${1:-}" != --launch-jack ]; then
    write_status waiting-network
    if wait_for_pi; then
        echo "jackd-launch: pi is reachable on $WIRED_IFACE; link is usable" >&2
    else
        echo "jackd-launch: proceeding with link unverified" >&2
    fi
    clear_status
    exec "$SUPPORT/jackbridge-coordinator" "$@"
fi
shift
RATE=48000
PERIOD=""
CLOCK_UID=""
while [ "$#" -gt 0 ]; do
    case "$1" in
        --rate) [ "$#" -ge 2 ] || exit 2; RATE="$2"; shift 2 ;;
        --period) [ "$#" -ge 2 ] || exit 2; PERIOD="$2"; shift 2 ;;
        --clock-device) [ "$#" -ge 2 ] || exit 2; CLOCK_UID="$2"; shift 2 ;;
        *) echo "jackd-launch: unexpected argument '$1'" >&2; exit 2 ;;
    esac
done

cap_log "$LOG_ERR"
cap_log "$LOG_OUT"

export JACKBRIDGE_INSTANCE="$$-$(/bin/date +%s)"

[ -x "$OWNER_HELPER" ] || { echo "jackd-launch: $OWNER_HELPER missing" >&2; exit 1; }

while :; do
    server_state=$("$OWNER_HELPER" state "$JACK_LSP" 2>/dev/null || printf '%s' none)
    case "$server_state" in
        none) clear_status; break ;;
        owned) write_status owned; echo "jackd-launch: existing JackBridge JACK server is waiting" >&2; sleep 10 ;;
        foreign) write_status foreign; echo "jackd-launch: a different program uses JACK; waiting" >&2; sleep 10 ;;
        *) write_status foreign; echo "jackd-launch: cannot classify JACK server; waiting" >&2; sleep 10 ;;
    esac
done

[ -x "$JACKD" ] || { echo "jackd-launch: jackd not found at $JACKD" >&2; exit 1; }
if [ -z "$CLOCK_UID" ]; then
    DETECT="$SUPPORT/jb-detect-builtin"
    [ -x "$DETECT" ] || { echo "jackd-launch: clock device detector missing" >&2; exit 1; }
    CLOCK_UID=$("$DETECT") || { echo "jackd-launch: no usable CoreAudio clock device" >&2; exit 1; }
fi

# JACK's CoreAudio driver silently falls back to the system default when a
# configured UID has disappeared. If that default is JackBridge, this creates
# a feedback loop: jackd clocks itself from the bridge it is supposed to feed.
# Validate explicit UIDs before starting JACK so a disconnected device fails
# loudly instead of selecting JackBridge.
if [ -n "$CLOCK_UID" ]; then
    if ! "$JACKD" -n "jackbridge-clock-probe-$$" -d coreaudio -l 2>&1 |
        /usr/bin/awk -v wanted="$CLOCK_UID" '
            /internal name =/ {
                line = $0
                sub(/^.*internal name = '\''/, "", line)
                sub(/'\''.*/, "", line)
                if (line == wanted) found = 1
            }
            END { exit found ? 0 : 1 }
        '
    then
        echo "jackd-launch: configured CoreAudio clock device is unavailable: $CLOCK_UID" >&2
        echo "jackd-launch: clear ClockDeviceUID or select an available UID; refusing fallback" >&2
        exit 1
    fi
fi
[ -n "$PERIOD" ] || { echo "jackd-launch: period was not supplied by coordinator" >&2; exit 1; }
echo "jackd-launch: using ClockDeviceUID=$CLOCK_UID rate=$RATE period=$PERIOD" >&2

export JACK_NETJACK_MULTICAST_IF="$WIRED_IFACE"
echo "jackd-launch: multicast route pinned to $WIRED_IFACE" >&2

JACKD_PID_FILE=/tmp/jackbridge-jackd.pid
rm -f "$JACKD_PID_FILE"

# jackd's stderr before the filter below removes repeats. The filter can only
# hide a message, thus a message that is absent from both files was never
# written. Read only for diagnosis.
#
# Keep the file of the previous jackd. The last lines of a jackd that stopped
# are the reason it stopped, and this agent starts a new jackd immediately
# after. Truncation here would delete exactly the evidence.
RAW_LOG="${JACKBRIDGE_RAW_LOG:-/tmp/jackbridge-jackd.raw.log}"
[ -s "$RAW_LOG" ] && /bin/mv -f "$RAW_LOG" "$RAW_LOG.prev"
: > "$RAW_LOG"

# fd 3 keeps a handle on the real stdout (the .out.log) before any pipe
# exists, so that below `2>&1` can send stderr into the filter while
# `1>&3` puts stdout back where launchd wanted it. Only stderr is noisy;
# routing both through one pipe would merge two files into one.
exec 3>&1

# `$!` cannot name jackd here: on a pipeline it names the last element, which
# is the filter. Killing that would leave jackd running with no parent and no
# pidfile. So the inner `sh -c` writes its OWN pid and then execs jackd into
# that same process — the pid stays valid across the exec, and the file names
# jackd itself.
#
# The filter prints each distinct message at most once per window and counts
# what it drops. It is not a consecutive-duplicate collapse: an xrun storm is
# a 3-or-4 line stanza per failed cycle (one XRun line per client that missed,
# plus the graph error, plus CoreAudio's overload notice when it also fired),
# repeating at the cycle rate — 375 Hz at 48 kHz / 128 frames. Consecutive
# dedupe collapses none of that. Digits are folded to # so that counters like
# `val1 = 7` group with `val1 = 8` instead of each looking distinct.
#
# This is jackd's stderr, written from its non-realtime logging path. The
# extra pipe hop touches no audio path and breaks no realtime constraint.
/bin/sh -c 'echo $$ > "$1"; shift; exec "$@"' _ "$JACKD_PID_FILE" \
    "$JACKD" -R -P 75 -d coreaudio -P "$CLOCK_UID" -r "$RATE" -p "$PERIOD" \
    2>&1 1>&3 3>&- \
  | /usr/bin/tee "$RAW_LOG" \
  | /usr/bin/perl -e '
        my $W = 10; my $CAP = 2000; my %s;
        $| = 1;
        while (defined(my $l = <STDIN>)) {
            chomp $l;
            my $k = $l; $k =~ s/\d+/#/g;
            %s = () if keys(%s) > $CAP;
            my $e = $s{$k} ||= [0, 0];
            my $now = time;
            if ($now - $e->[0] >= $W) {
                if ($e->[1]) { printf("%s   [+%d similar suppressed]\n", $l, $e->[1]); }
                else         { printf("%s\n", $l); }
                @$e = ($now, 0);
            } else { $e->[1]++; }
        }
        for my $k (sort keys %s) {
            printf("  [+%d similar suppressed: %s]\n", $s{$k}[1], $k) if $s{$k}[1];
        }
    ' >&2 &
PIPELINE_PID=$!

# The pidfile appears between fork and exec, so wait for it briefly.
JACKD_PID=""
_i=0
while [ "$_i" -lt 40 ]; do
    if [ -s "$JACKD_PID_FILE" ]; then JACKD_PID=$(cat "$JACKD_PID_FILE"); break; fi
    _i=$((_i + 1))
    sleep 0.05
done
if [ -z "$JACKD_PID" ]; then
    echo "jackd-launch: jackd pid file never appeared" >&2
    kill "$PIPELINE_PID" 2>/dev/null || true
    exit 1
fi

# EXIT always stops jackd, as before: every exit path below is a repair that
# needs a new jackd. INT and TERM only add a log line and then exit, which
# runs the EXIT trap.
#
# The log lines separate the two ways this agent can end: a signal to the
# agent, which takes jackd down with it, and jackd stopping first, which lets
# the monitor loop fall through. The two have different causes and the log did
# not tell them apart.
trap 'kill "$JACKD_PID" 2>/dev/null || true; rm -f "$JACKD_PID_FILE"' EXIT
trap 'echo "jackd-launch: agent got SIGINT; stopping jackd $JACKD_PID" >&2; exit 0' INT
trap 'echo "jackd-launch: agent got SIGTERM; stopping jackd $JACKD_PID" >&2; exit 0' TERM

jackd_ready=0
for i in $(seq 1 30); do
    if "$JACK_LSP" >/dev/null 2>&1; then jackd_ready=1; break; fi
    sleep 0.5
done
if [ "$jackd_ready" = 1 ] && [ -x "$JACK_LOAD" ]; then
    for i in 1 2 3 4 5; do
        if "$JACK_LOAD" netmanager >/dev/null 2>&1; then
            echo "jackd-launch: netmanager loaded" >&2; break
        fi
        echo "jackd-launch: jack_load netmanager attempt $i failed" >&2
        sleep 1
    done
elif [ "$jackd_ready" != 1 ]; then
    echo "jackd-launch: jackd not ready after 15s" >&2
fi
# The IPv6 scopeid is the ifindex. It changes when the interface is destroyed
# and made again. It does not change when only the carrier drops.
iface_token() {
    /sbin/ifconfig "$1" 2>/dev/null | /usr/bin/awk '/scopeid/ { print $NF; exit }'
}

# Self-heal. netmanager cannot bind its multicast interface again while it
# runs. Thus a fresh jackd is the only repair when the group must move. Exit
# to do this repair: KeepAlive starts the agent again.
#
# A carrier drop is not that condition. The interface, the ifindex and the pin
# stay the same. A restart then destroys a master that the pi still uses, and
# recovery takes 80 s in place of 4 s. Thus wait for an absent interface. Do
# not restart.
WIRED_TOKEN=$(iface_token "$WIRED_IFACE")

while kill -0 "$JACKD_PID" 2>/dev/null; do
    sleep 2
    now_iface=$(wired_iface || true)

    # The cable is out, or the link starts again. Wait.
    [ -z "$now_iface" ] && continue

    if [ "$now_iface" = "$WIRED_IFACE" ]; then
        # An unknown token can be a wrong restart. Thus ignore it.
        now_token=$(iface_token "$now_iface")
        if [ -z "$now_token" ] || [ -z "$WIRED_TOKEN" ] || [ "$now_token" = "$WIRED_TOKEN" ]; then
            continue
        fi
        echo "jackd-launch: $WIRED_IFACE was made again (scope $WIRED_TOKEN -> $now_token); restarting" >&2
        exit 0
    fi

    # A new link sends a burst of changes. Look a second time before you act.
    sleep 2
    now_iface=$(wired_iface || true)
    [ -z "$now_iface" ] && continue
    [ "$now_iface" = "$WIRED_IFACE" ] && continue
    echo "jackd-launch: wired interface moved $WIRED_IFACE -> $now_iface; restarting" >&2
    exit 0
done

# Only reached when jackd stopped and no signal came to this agent.
#
# Do not report an exit status here. jackd is a member of a pipeline, thus the
# shell does not own it as a job, thus `wait` on it returns 0 whatever jackd
# did. That 0 reads as a clean stop and is not one: the first time this line
# appeared, jackd had in fact stopped with SIGTRAP. Use the crash reports in
# ~/Library/Logs/DiagnosticReports and $RAW_LOG instead.
echo "jackd-launch: jackd $JACKD_PID stopped; see $RAW_LOG.prev and DiagnosticReports" >&2
wait "$PIPELINE_PID"
