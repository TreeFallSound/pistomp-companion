#!/bin/sh
# Long-running route pinner: re-runs jackbridge-pin-route on every macOS
# network-state change (cable plug/unplug, link change, lease change, Wi-Fi
# join, etc.). JACK service lifecycle belongs to the Companion GUI, not this
# system daemon.
#
# The watcher only owns routing state. It must not bootstrap or stop the
# per-user JACK agents: doing that would let JACK survive after the GUI quits
# and would also race the GUI's explicit start/stop commands.
#
# Steady state is one sleeping process. Pin-script failures don't tear down
# the watcher — we want to keep waiting for the network to come back rather
# than fail-loop the LaunchDaemon.
set -u

SUPPORT="/Library/Application Support/JackBridge"
. "$SUPPORT/jb-is-wifi-iface"

PIN="$SUPPORT/jackbridge-pin-route"
ROUTE_STATE=/var/run/jackbridge-route.iface
SENTINEL=/var/run/jackbridge-ethernet.up

"$PIN" || true

new_iface=$(cat "$ROUTE_STATE" 2>/dev/null || true)

if [ -n "$new_iface" ] && ! is_wifi_iface "$new_iface"; then
    # Wired or direct-cable interface found. Keep route maintenance here;
    # service start/stop belongs exclusively to the Companion GUI.
    touch "$SENTINEL"
    # Flush stale link-local ARP entries before a GUI-started jackd resolves
    # the configured Pi hostname.
    for stale in $(/usr/sbin/arp -an 2>/dev/null | \
                   awk '/169\.254\./ { gsub(/[()]/, "", $2); print $2 }'); do
        /usr/sbin/arp -d "$stale" 2>/dev/null || true
    done
    echo "jackbridge-route-watcher: ethernet up on $new_iface — route pinned; JACK remains GUI-owned" >&2

        # Background: listen for the pi's netJACK2 discovery packets (UDP to
        # 225.3.19.154:19000) and pin a host route on the wired interface for
        # each source IP we see. Without this, ARP requests for the pi's
        # link-local address go out every interface matching 169.254/16, and
        # the wifi router's proxy-ARP reply often wins — poisoning the cache
        # with the router's MAC. An interface-scoped host route restricts ARP
        # resolution to the wired interface only — the router never sees the
        # probe. The pi's reply teaches the kernel the correct MAC on en7;
        # continuous netJACK2 audio traffic keeps the ARP entry warm thereafter.
        #
        # We use `route add -host -interface` rather than `ping -b` because
        # the route-watcher's own ARP flush (above) would delete any
        # ping-learned ARP entry on the next network-change cycle. A host
        # route is persistent across ARP flushes and survives until explicitly
        # removed or the interface goes down.
        # tcpdump uses BPF which is root-only (we're a LaunchDaemon).
        #
        # tcpdump runs ONCE and streams (-l for line buffering), rather than
        # -c 1 inside a respawn loop. With the pi connected, netJACK2
        # discovery multicast arrives continuously, so a -c 1 loop captures
        # and exits immediately — measured at ~10 fork/exec of tcpdump per
        # second, forever, each re-adding a route that already existed and
        # writing a duplicate log line (~500 KB/min into an unrotated log).
        # On a host whose whole job is low-latency audio, that churn comes
        # straight out of the jitter budget.
        #
        # We also only act when the address actually changes: the route add
        # is idempotent, so re-adding a known IP is pure noise.
        (
            last_ip=
            while :; do
                tcpdump -i "$new_iface" -n -l 'udp dst port 19000' 2>/dev/null | \
                awk '{
                    for(i=1;i<=NF;i++)
                        if(match($i,/^225\.3\.19\.154\.19000:?$/)) {
                            split($(i-2),a,".")
                            print a[1]"."a[2]"."a[3]"."a[4]
                            fflush()
                            next
                        }
                }' | while read pi_ip; do
                    [ -n "$pi_ip" ] || continue
                    [ "$pi_ip" = "$last_ip" ] && continue
                    # Add an interface-scoped host route. This restricts
                    # ARP resolution to the wired interface — the wifi
                    # router never sees the request and can't proxy-ARP
                    # a reply. The route is idempotent; if it already
                    # exists, the add is a no-op.
                    /sbin/route -n add -host "$pi_ip" -interface "$new_iface" >/dev/null 2>&1 || true
                    echo "jackbridge-route-watcher: pinned $pi_ip to $new_iface" >&2
                    last_ip=$pi_ip
                done
                # Only reached if tcpdump exits (interface down, BPF error).
                # A network change restarts the whole watcher via launchd;
                # this sleep just keeps a hard failure from hot-looping.
                /bin/sleep 2
            done
        ) &
else
    # No ethernet (or fell back to wifi).
    rm -f "$SENTINEL"
    if [ -n "$new_iface" ]; then
        echo "jackbridge-route-watcher: wifi-only ($new_iface) — JACK remains GUI-owned" >&2
    else
        echo "jackbridge-route-watcher: no network — JACK remains GUI-owned" >&2
    fi
fi

exec /usr/bin/notifyutil -1 com.apple.system.config.network_change
